<Window xmlns="https://github.com/avaloniaui"
        xmlns:views="clr-namespace:LumeFetch.Presentation.Views;assembly=LumeFetch.Presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LumeFetch.Desktop.Views.MainWindow"
        Title="LumeFetch"
        Icon="/Assets/lumefetch.ico"
        Width="1220"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <views:MainView x:Name="MainContent" />
</Window>
