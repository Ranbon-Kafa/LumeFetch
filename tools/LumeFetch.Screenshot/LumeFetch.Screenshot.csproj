<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LumeFetch.Screenshot</RootNamespace>
    <AssemblyName>LumeFetch.Screenshot</AssemblyName>
    <!-- Reflection bindings intentionally consume instance-only preview properties. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LumeFetch.Desktop\LumeFetch.Desktop.csproj" />
  </ItemGroup>
</Project>
